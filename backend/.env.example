# Copy to .env (or .env.local) and fill in — never commit the real key.
# Any chat-completion provider key works here; the default client (app/llm.py)
# targets a Claude-class model but swapping the model string is a one-line change.
LLM_API_KEY=your-provider-api-key

# Optional overrides:
# SKY_INTAKE_MODEL=claude-haiku-4-5-20251001
# SKY_INTAKE_FAKE_LLM=1   # use the offline regex-based FakeLLMClient instead of a real model call
