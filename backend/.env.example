# Copy to .env (or .env.local) and fill in — never commit the real key.
# The key must match whichever provider MODEL_PROVIDER selects below
# (an Anthropic key for "anthropic", an OpenAI key for "openai").
LLM_API_KEY=your-anthropic-api-key

# Optional overrides:
# MODEL_PROVIDER=anthropic   # or "openai" — picks which ChatModel build_model() returns
# MODEL_NAME=claude-haiku-4-5-20251001   # or e.g. gpt-5-mini when MODEL_PROVIDER=openai
# SKY_INTAKE_FAKE_LLM=1   # use the offline FakeAgentModel instead of a real model call
