# Copy to .env (or .env.local) and fill in — never commit the real key.
# The v2 agent is Anthropic-only (via langchain-anthropic/ChatAnthropic) —
# this must be a real Anthropic API key, not an OpenAI-style key.
LLM_API_KEY=your-anthropic-api-key

# Optional overrides:
# MODEL_NAME=claude-haiku-4-5-20251001
# SKY_INTAKE_FAKE_LLM=1   # use the offline FakeAgentModel instead of a real model call
